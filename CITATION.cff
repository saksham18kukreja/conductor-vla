    given-names: Saksham
repository-code: "https://github.com/saksham18kukreja/conductor-vla"
license: Apache-2.0
version: 0.1.0
date-released: "2026-10-16"
keywords:
  - robotics
  - vision-language-action
  - VLA
  - agentic
  - LIBERO
  - LeRobot
  - SmolVLA
